# WhatsApp del dueño/complejo (código país + número, sin + ni espacios)
VITE_WHATSAPP_OWNER=5493511234567

# Firebase (consola → Project settings → Your apps → Web)
# Sin estas variables la app corre en modo local (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email del dueño (placeholder). Cambialo al tuyo en .env local, no en el repo.
VITE_ADMIN_EMAIL=tu-email-admin@ejemplo.com

