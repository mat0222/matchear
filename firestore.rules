rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    // IMPORTANTE: reemplazá este email por el del dueño del complejo (minúsculas).
    // Solo ese email puede auto-asignarse rol admin al crear el perfil.
    function isBootstrapAdminEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'admin@matchear.com';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'user';

      // El dueño puede subir a admin una sola vez (bootstrap). Nadie más puede tocar `role`.
      allow update: if isOwner(userId)
        && (
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          )
          || (
            resource.data.role == 'user'
            && request.resource.data.role == 'admin'
            && isBootstrapAdminEmail()
          )
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name']);
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pitchId is string
        && request.resource.data.date is string
        && request.resource.data.slot is string
        && request.resource.data.status in ['pending_payment', 'confirmed']
        && request.resource.data.whatsapp is string;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.pitchId == resource.data.pitchId
        && request.resource.data.date == resource.data.date
        && request.resource.data.slot == resource.data.slot
        && (
          request.resource.data.status in ['cancelled', 'reserved', 'confirmed']
        );

      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'paid'];

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bookingId == resource.data.bookingId;

      allow update, delete: if isAdmin();
    }

    // Candados de horario: evitan doble reserva (escritura vía transacción).
    // Lectura pública para mostrar ocupación sin filtrar datos personales.
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.pitchId is string
        && request.resource.data.date is string
        && request.resource.data.slot is string;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
